{
  "name": "purfence-api",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "repository": "",
  "scripts": {
    "build": "nest build",
    "codegen": "graphql-codegen --config codegen.yml --concurrency 1",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:oauth-callback": "ts-node src/oauth-callback/server.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS='--experimental-vm-modules --max-old-space-size=4096' jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector",
    "typeorm": "node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli.js",
    "typeorm:migration:generate": "npm run typeorm -- -d ./ormconfig.ts migration:generate",
    "typeorm:migration:create": "npm run typeorm migration:create",
    "typeorm:migration:run": "npm run typeorm -- -d ./ormconfig.ts migration:run",
    "typeorm:schema:sync": "npm run typeorm -- -d ./ormconfig.ts schema:sync",
    "typeorm:seed:create": "cross-env TYPEORM_SEED=1 npm run typeorm:migration:create",
    "typeorm:seed:run": "cross-env TYPEORM_SEED=1 npm run typeorm:migration:run",
    "typeorm:seed:revert": "cross-env TYPEORM_SEED=1 npm run typeorm -- -d ./ormconfig.ts migration:revert",
    "typeorm:migration:generate:staging": "env-cmd -f .env.migration npm run typeorm:migration:generate",
    "prepare": "is-ci || husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.6",
    "@ai-sdk/google-vertex": "^4.0.6",
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/openai-compatible": "^2.0.26",
    "@anthropic-ai/claude-agent-sdk": "^0.1.74",
    "@anthropic-ai/sdk": "^0.71.2",
    "@anthropic-ai/vertex-sdk": "^0.14.0",
    "@apollo/server": "^4.12.2",
    "@apollo/subgraph": "^2.11.2",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@nest-mods/auth": "^11.0.0",
    "@nest-mods/log": "^10.0.0",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "13.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.11",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.11",
    "@ptc-org/nestjs-query-core": "^9.1.0",
    "@ptc-org/nestjs-query-graphql": "^9.1.0",
    "@ptc-org/nestjs-query-typeorm": "^9.1.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.14.1",
    "@types/async-retry": "^1.4.9",
    "@voltagent/core": "^2.3.1",
    "@voltagent/logger": "^2.0.2",
    "@voltagent/server-hono": "^2.0.4",
    "ai": "^6.0.68",
    "app-root-path": "^3.1.0",
    "axios": "^1.11.0",
    "axios-curlirize": "^2.0.0",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^7.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron": "^3.5.0",
    "dataloader": "^2.2.3",
    "elastic-apm-node": "^4.13.0",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-query-complexity": "^1.1.0",
    "graphql-request": "^6.1.0",
    "graphql-scalars": "^1.24.2",
    "gray-matter": "^4.0.3",
    "hpagent": "^1.2.0",
    "lodash": "^4.17.21",
    "markitdown-ts": "^0.0.8",
    "mime-types": "^3.0.1",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "nestjs-pino": "^4.4.0",
    "nestjs-request-context": "^4.0.0",
    "nodejs-snowflake": "^2.0.1",
    "p-queue": "^6.6.2",
    "pino-http": "^10.5.0",
    "pretty-ms": "^9.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.25",
    "typeorm-transactional": "^0.5.0",
    "undici": "^7.21.0",
    "yn": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@parcel/watcher": "^2.5.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^29.7.0",
    "jest-extended": "^6.0.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  },
  "lint-staged": {
    "*.{ts,graphql}": [
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(e2e-)?spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/",
      "<rootDir>/test/"
    ],
    "moduleNameMapper": {
      "^@src(|/.*)$": "<rootDir>/src/$1",
      "^@app/cache(|/.*)$": "<rootDir>/libs/cache/src/$1",
      "^@app/hotfix(|/.*)$": "<rootDir>/libs/hotfix/src/$1",
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@app/my-agent(|/.*)$": "<rootDir>/libs/my-agent/src/$1"
    },
    "forceExit": true,
    "setupFiles": [
      "./load-env.ts"
    ],
    "setupFilesAfterEnv": [
      "jest-extended/all",
      "./test/setup.ts"
    ]
  },
  "overrides": {
    "@browserbasehq/stagehand": "file:local-packages/stagehand-stub"
  }
}
