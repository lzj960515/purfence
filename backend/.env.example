# App environment
APP_ENV=development
SERVER_PORT=1016

# Database (SQLite)
TYPEORM_DATABASE=./data/database.sqlite
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# AI Database (SQLite)
TYPEORM_AI_DATABASE=./data/ai-database.sqlite
TYPEORM_AI_SYNCHRONIZE=true
TYPEORM_AI_LOGGING=false

# VoltAgent LibSQL Memory
VOLTAGENT_MEMORY_URL=file:./data/voltagent-memory.db

# Encryption key (64 hex characters = 32 bytes)
# Generate method: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Model Provider Configuration (Fallback - used if no database config is set)
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Zhipu (GLM)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/anthropic/v1

# OpenAI Codex OAuth
# Client ID and Secret from OpenAI Auth0 application
# Get these from: https://auth0.openai.com/
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
# Redirect URI must match the one registered in your OAuth application
OPENAI_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# OAuth scopes - openid profile email offline_access are required for Codex
OPENAI_OAUTH_SCOPE=openid profile email offline_access

# Optional integrations
SENDGRID_API_KEY=
AES_SECRET=
AES_IV=
